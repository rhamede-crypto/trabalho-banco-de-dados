    "test:e2e": "playwright test",
    "test:db": "node --test integration/postgis.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0"
  }
}
